# Copy this file to ".dev.vars" (which is gitignored) for local `wrangler dev`.
# These are read as the Worker's env secrets when running locally. Do NOT put
# real values in this example file or commit your real .dev.vars.

TA_USERNAME = "your-student-number"
TA_PASSWORD = "your-password"

# Only needed if REQUIRE_API_KEY = true in src/index.js
API_KEY = "some-long-random-string"

# Optional: AI tutor (Pages project secret). Never commit a real key.
OPENAI_API_KEY = "sk-your-key-here"

# Cloud saving (dreams, goals, last-known marks). Pages secrets; never commit real values.
NEXT_PUBLIC_SUPABASE_URL = "https://hcvjiveloioftozvnbhe.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_..."
# Optional: chat model (default gpt-4.1-mini)
OPENAI_MODEL = "gpt-4.1-mini"
